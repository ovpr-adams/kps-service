# ----------------------------
# Configuration Production o2switch
# ----------------------------
NODE_ENV=production
PORT=5000

# ----------------------------
# Base de données MongoDB Atlas (recommandé)
# ----------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kps-services

# ----------------------------
# Frontend URL pour CORS (votre domaine)
# ----------------------------
FRONTEND_URL=https://votre-domaine.com

# ----------------------------
# JWT (authentification)
# ----------------------------
JWT_SECRET=votre-super-secret-jwt-key-production-change-this
JWT_EXPIRE=30d

# ----------------------------
# Configuration Email (o2switch SMTP)
# ----------------------------
EMAIL_HOST=brune.o2switch.net
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=contact@kpsservices.fr
EMAIL_PASS=votre-mot-de-passe-email-o2switch
EMAIL_FROM="KPS Services <contact@kpsservices.fr>"
EMAIL_TO=Contact@kpsservices.fr,Commercial@kpsservices.fr

# ----------------------------
# URL de l'application (pour les liens dans les emails)
# ----------------------------
APP_URL=https://votre-domaine.com

# ----------------------------
# Admin par défaut (pour tests)
# ----------------------------
ADMIN_EMAIL=admin@kpsservices.fr
ADMIN_PASSWORD=votre-mot-de-passe-admin-securise
